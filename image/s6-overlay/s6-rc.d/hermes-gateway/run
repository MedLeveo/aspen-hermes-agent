#!/command/with-contenv sh
# The Hermes gateway, supervised, as uid 10000.
#
# `plow-init` published the tenant's environment under
# /run/s6/container_environment, and with-contenv hands it to this script, so
# there is nothing here to read or parse.
set -eu

# The only two values that differ from the image's own ENV. The API server is
# loopback-only: the agent's sole path to Plow is the outbound socket the chat
# plugin opens, so there is nothing to expose.
export API_SERVER_HOST=127.0.0.1
export API_SERVER_PORT=8642

# with-contenv repopulates HOME from /init, which ran as root, so without this
# the gateway drops to uid 10000 still pointed at /root -- a directory it
# cannot write, where anything HOME-anchored silently lands.
export HOME=/var/lib/hermes

cd /opt/hermes
# --force alongside --replace, for a host where the refusal fires wrongly.
#
# `hermes gateway run` refuses when it sees an s6 service for this profile
# already installed and running, because the case it is written for is a person
# starting a second gateway from a shell -- which would leave an orphan
# dispatcher writing to the same kanban DB. Here s6 IS the supervisor and
# --replace is the sanctioned way to take over, so the check has nothing to
# protect: the only thing it can refuse is the gateway s6 was told to run.
#
# On Railway that refusal fires about ninety seconds after a clean boot and
# then repeats every two seconds indefinitely, burning 0.6 vCPU and leaving no
# gateway up -- which is why the daily message never arrived. It does not
# reproduce locally on the same image and commit, and nothing logs a crash, so
# the trigger is still unknown. --force removes the refusal's ability to be the
# thing that stops it; --replace still guarantees one gateway.
exec /command/s6-setuidgid hermes /opt/hermes/.venv/bin/hermes gateway run --replace --no-supervise --force
