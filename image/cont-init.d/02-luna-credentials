#!/command/with-contenv sh
# Write the credential from the environment, on a host that cannot mount a file.
#
# `plow-agents` mints ./plow-credentials and compose bind-mounts it, which is
# the supported path and the one the README documents. A PaaS has no bind
# mount: it hands a container environment variables and nothing else. This
# writes the same two lines the image reads, in the same place, with the same
# ownership and mode plow-init insists on.
#
# It NEVER overwrites an existing credential. plow-init drops the process
# environment as a source on purpose -- so that `docker run -e
# PLOW_AGENT_TOKEN=...` cannot outrank the credential the image was actually
# given, which would be a rotation silently not taking. Refusing to touch a
# file that is already there keeps that property intact: the mounted
# credential always wins, and this only fills a gap nobody else filled.
#
# Runs before plow-init, which is an s6-rc oneshot and therefore later than
# every cont-init script.
set -eu

CRED=/var/lib/plow/credentials

# A credential this script did not write is authoritative: on compose it is the
# bind mount, already copied into place by 00-plow-sanitize. Leave it.
#
# One this script DID write is a different case. The environment is where a PaaS
# rotates a token, and refusing to touch our own file would mean a rotated token
# never takes -- the container would keep presenting a revoked one. So the
# marker records which of the two we are looking at, rather than guessing from
# the file.
MARKER=/var/lib/plow/.written-from-env

if [ -e "$CRED" ] && [ ! -e "$MARKER" ]; then
  echo "[luna] credential present and not ours -- leaving it alone"
  exit 0
fi

if [ -z "${PLOW_AGENT_TOKEN:-}" ] || [ -z "${PLOW_API_BASE:-}" ]; then
  # Not an error: on a compose host the file arrives by mount, and plow-init
  # waits for it. Saying nothing here would make that wait look like a hang.
  echo "[luna] no PLOW_AGENT_TOKEN/PLOW_API_BASE in the environment -- expecting a mounted credential"
  exit 0
fi

install -d -m 0755 -o root -g root /var/lib/plow
umask 077
tmp="$CRED.incoming"
printf 'PLOW_API_BASE=%s\nPLOW_AGENT_TOKEN=%s\n' "$PLOW_API_BASE" "$PLOW_AGENT_TOKEN" > "$tmp"
chown root:root "$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$CRED"
: > "$MARKER"
chmod 0600 "$MARKER"
echo "[luna] wrote $CRED from the environment"
