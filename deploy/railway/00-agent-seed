#!/command/with-contenv sh
# Unpack the agent's home into the mounted volume, then write its dotenv from
# the platform's environment. Runs before the gateway, every boot.
#
# Shebang note, the same one main-wrapper.sh carries: /init scrubs the
# environment before running cont-init scripts, so a plain `#!/bin/sh` here
# sees an empty environ and every platform variable reads as unset -- which is
# how the first deploy wrote a .env with zero entries. with-contenv repopulates
# it from /run/s6/container_environment.
#
# Two different rules, deliberately:
#
#   authored here  (SOUL.md, the prenatal skill)  -- overwritten every boot, so
#                  a redeploy is how the agent changes.
#   not ours       (plugins, fleet skills, config.yaml) -- copied only when
#                  absent, so a later Hermes never has its state clobbered.
#
# State the agent accumulates (sessions, cron, the record) lives on the volume
# and is never touched here.
set -eu

DATA=/opt/data
SEED=/opt/seed

[ -d "$SEED" ] || { echo "[seed] no $SEED in image -- broken build" >&2; exit 1; }

mkdir -p "$DATA"

# --- copy-if-absent -------------------------------------------------------
# Only the plugin and the fleet skills. NOT config.yaml: Hermes writes a
# default one on first boot when the volume is empty, and copy-if-absent would
# then preserve that default forever -- an agent with no Gemini provider, no
# Plow Chat platform and no latch server, which is how the first deploy came
# up. agent-mgr reinstalls config.yaml on every deploy for the same reason.
for path in plugins skills; do
  if [ ! -e "$DATA/$path" ] && [ -e "$SEED/$path" ]; then
    cp -R "$SEED/$path" "$DATA/$path"
    echo "[seed] installed $path"
  fi
done

# --- always refreshed: what this repo authors -----------------------------
for path in SOUL.md config.yaml; do
  if [ -f "$SEED/$path" ]; then
    cp "$SEED/$path" "$DATA/$path"
    echo "[seed] refreshed $path"
  fi
done
if [ -d "$SEED/skills/health/prenatal" ]; then
  mkdir -p "$DATA/skills/health"
  rm -rf "$DATA/skills/health/prenatal.incoming"
  cp -R "$SEED/skills/health/prenatal" "$DATA/skills/health/prenatal.incoming"
  rm -rf "$DATA/skills/health/prenatal"
  mv "$DATA/skills/health/prenatal.incoming" "$DATA/skills/health/prenatal"
  echo "[seed] refreshed prenatal skill"
fi

mkdir -p "$DATA/nina/exams"

# --- the dotenv the gateway reads ----------------------------------------
# Written from the environment rather than baked into the image: none of these
# belong in a layer, and Railway is where they are set. Only names that are
# actually set are written, so an unset optional key stays absent rather than
# becoming an empty string that shadows nothing.
tmp="$DATA/.env.incoming"
: > "$tmp"
for name in PLOW_API_BASE PLOW_AGENT_TOKEN PLOW_HOME_CHANNEL \
            PLOW_CHAT_BASE_URL PLOW_CHAT_TOKEN PLOW_CHAT_CHAT_UID \
            PLOW_CHAT_HOME_CHANNEL \
            DOMO_DEVICE_UID DOMO_MCP_TOKEN \
            GEMINI_API_KEY AGENT_TZ; do
  eval "value=\${$name:-}"
  [ -n "$value" ] && printf '%s=%s\n' "$name" "$value" >> "$tmp"
done
chmod 600 "$tmp"
mv "$tmp" "$DATA/.env"
echo "[seed] wrote .env with $(wc -l < "$DATA/.env") entries"

# --- scheduled jobs -------------------------------------------------------
# What `agent-mgr cron-sync` does from the operator's machine, done from the
# image instead. Never fatal: the script swallows its own failures, and the
# `|| true` covers the case where it cannot start at all.
if [ -x /opt/seed/register-crons.py ]; then
  /opt/seed/register-crons.py || true
fi
