#!/command/with-contenv sh
# Register this agent's scheduled jobs. Separate from 00-agent-seed, and
# deliberately later in the sequence.
#
# The seeding has to happen BEFORE the image's own 01-hermes-setup, so
# config.yaml is in place when Hermes initialises. Creating a cron is the
# opposite: it needs a Hermes that has finished initialising, and it writes into
# /opt/data as the hermes user -- doing it at 00 as root produced a traceback
# and would have left root-owned files under a home the gateway then cannot
# write.
#
# Never fatal: a container that cannot register a reminder still answers
# messages, and failing the boot would trade one for the other.
set -eu

[ -x /opt/seed/register-crons.py ] || exit 0

if command -v s6-setuidgid >/dev/null 2>&1 && [ "$(id -u)" = 0 ]; then
  s6-setuidgid hermes /opt/seed/register-crons.py || true
else
  /opt/seed/register-crons.py || true
fi
